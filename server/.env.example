# Which LLM provider classify.js calls — "ollama" (default, local qwen3.5:0.8b) or "gemini"
LLM_PROVIDER=ollama

# Required when LLM_PROVIDER=gemini
# Supports Gemini models (gemini-2.5-flash, gemini-2.0-flash, …)
# and Gemma models via Google AI API (gemma-4-27b-it, gemma-3-27b-it, …)
# Note: Gemma models use responseMimeType only (no responseSchema / thinkingConfig)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-27b-it

# WIRE platform MCP server — when set, list/read sync WIRE issues into task.json
# and add/edit on wire-sourced tasks call the MCP tools directly.
# WIRE authenticates with per-module token headers (not OAuth/Bearer); set the
# token(s) you were issued. Work = the Jira-like issue module this agent targets.
MCP_SERVER_URL=https://wire.lgcns.com/wiremcp/sse
MCP_WORK_KEY=          # WIRE-Work token  → sent as the "Work-Key" header
MCP_WIKI_KEY=          # WIRE-Wiki token  → sent as the "Wiki-Key" header (optional)
MCP_CODE_KEY=          # WIRE-Code token  → sent as the "Code-Key" header (optional)
MCP_SOURCE=wire        # source id for synced tasks
MCP_QUERY=             # optional filter for which issues to sync
