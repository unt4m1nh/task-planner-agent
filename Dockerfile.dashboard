FROM node:20-alpine AS builder

WORKDIR /build
COPY client/client/package*.json ./
RUN npm ci
COPY client/client/ .
# Point API at core service over compose network (set at build time)
ARG VITE_API_URL=http://core:3000
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:alpine
COPY --from=builder /build/dist /usr/share/nginx/html
# Serve the obs dashboard alongside the main app
COPY dashboard /usr/share/nginx/html/obs
COPY nginx.dashboard.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
