FROM node:20-bookworm

WORKDIR /app

# Install Python + uv so the Jira MCP server (uvx mcp-atlassian, stdio child) runs inside this container
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip curl ca-certificates && \
    pip3 install uv --break-system-packages && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy package files and install dependencies
# Native modules (better-sqlite3, sqlite-vec) must be compiled for the image arch
COPY server/package*.json server/
RUN cd server && npm ci --omit=dev

# Rebuild native addons for image arch — sqlite-vec ships a prebuilt .node but
# better-sqlite3 always rebuilds. Force rebuild to guarantee correct binary.
RUN cd server && npm rebuild better-sqlite3

# Copy application source
COPY server/src ./server/src
COPY task.json ./

# Data dir — all SQLite files live here, mounted as a named volume in production
RUN mkdir -p /app/data
ENV OBS_DB_PATH=/app/data/obs.db
ENV CHECKPOINTS_DB_PATH=/app/data/checkpoints.db
ENV RAG_DB_PATH=/app/data/rag.db

# Ollama runs on the host; containers reach it via host.docker.internal
ENV OLLAMA_HOST=http://host.docker.internal:11434

EXPOSE 3000

CMD ["node", "server/src/index.js"]
